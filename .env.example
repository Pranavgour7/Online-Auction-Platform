# MongoDB Connection string (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/auction-platform?retryWrites=true&w=majority

# Port for the Node/Express backend server
PORT=5000

# Secret key for JWT signing
JWT_SECRET=your_production_jwt_secret_key_here

# Frontend origin URL for CORS (in production, your deployed frontend URL or leave blank if served together)
CLIENT_URL=http://localhost:3000

# Environment mode (development / production)
NODE_ENV=production

